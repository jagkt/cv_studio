# ==============================================================================
# AI Career & Academic Document Studio - Environment Configuration
# Copy this file to `.env` and fill in your API credentials.
# NEVER commit your actual `.env` file to version control.
# ==============================================================================

# Required: Your Groq Cloud API Key (https://groq.com)
GROQ_API_KEY="gsk_your_groq_api_key_here"

# Optional: Active Groq Model ID (defaults to openai/gpt-oss-20b)
# Recommended active models:
#   - openai/gpt-oss-20b   (Fast, generous free-tier token limits)
#   - openai/gpt-oss-120b  (Higher reasoning capacity)
#   - qwen/qwen3.8-27b     (Note: strict 1,000 OTPM limit on free tier)
GROQ_MODEL="openai/gpt-oss-20b"
